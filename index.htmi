低欸分<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#090b16"><title>骰界 RNG</title>
<style>
:root{--bg:#080a13;--panel:#111527;--panel2:#171d32;--line:#29304b;--text:#edf0ff;--muted:#929bb9;--blue:#7b8cff;--purple:#bb83ff;--cyan:#69e5ff;--gold:#ffd27a}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -20%,#25234b 0,transparent 55%),var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,"Noto Sans TC",sans-serif;min-height:100vh}
button,input,select{font:inherit}button{cursor:pointer;border:1px solid var(--line);border-radius:12px;background:#1b2340;color:var(--text);padding:10px 14px;transition:.15s}button:hover{border-color:#7b8cff;filter:brightness(1.1)}button:disabled{opacity:.35;cursor:not-allowed}.primary{background:linear-gradient(120deg,#6677ff,#995fff);border:0;font-weight:800}.quiet{background:#111629}.danger{background:#341c2a}.shell{max-width:1150px;margin:auto;padding:16px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 0 18px}.brand{font-weight:900;letter-spacing:1px;font-size:21px}.brand span{color:var(--cyan)}.pill{font-size:12px;border:1px solid var(--line);padding:5px 9px;border-radius:999px;color:var(--muted)}.profile{display:flex;align-items:center;gap:9px}.avatar{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#394a91,#8d5bb8);font-weight:900}.layout{display:grid;grid-template-columns:215px minmax(0,1fr);gap:16px}.nav{background:#0e1221d9;border:1px solid var(--line);border-radius:18px;padding:10px;height:max-content;position:sticky;top:10px}.nav button{width:100%;text-align:left;margin:3px 0;background:transparent;border-color:transparent;color:var(--muted)}.nav button.active{background:#222a4b;color:white;border-color:#3b477b}.nav small{display:block;color:#717c9e;padding:10px 10px 4px}.content{min-width:0}.page{display:none}.page.active{display:block}.hero{border:1px solid #34345e;border-radius:22px;background:linear-gradient(135deg,#151a32eF,#20193cdd);padding:22px;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:240px;height:240px;right:-70px;top:-100px;border-radius:50%;background:#8c68ff22;filter:blur(5px)}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--cyan);font-weight:800}.hero h1{margin:4px 0;font-size:clamp(24px,4vw,34px)}.muted{color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}.stat,.card{background:linear-gradient(145deg,#13192b,#101424);border:1px solid var(--line);border-radius:16px;padding:14px}.stat b{font-size:21px;display:block}.stat span{font-size:12px;color:var(--muted)}.rollbox{margin-top:14px;background:radial-gradient(ellipse at 50% 15%,#30346c 0,#151a31 52%,#101423 100%);border:1px solid #343b67;border-radius:22px;text-align:center;padding:24px 14px;position:relative}.dice{width:128px;height:128px;margin:0 auto 14px;display:grid;place-items:center;font-size:66px;border-radius:28px;background:linear-gradient(145deg,#252d54,#11162a);border:1px solid #6571bd;box-shadow:0 0 35px #7468ff28,inset 0 0 20px #ffffff0b;transform:rotate(-5deg);position:relative}.dice:before{content:"";position:absolute;inset:8px;border:1px solid #ffffff17;border-radius:20px}/* 擲骰按鈕白色進度線：由左至右走完後才可再次擲骰 */
.roll-actions button{position:relative;overflow:hidden;isolation:isolate}
.roll-actions button>*{position:relative;z-index:1}
.roll-actions button.roll-progress::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:3px;background:linear-gradient(90deg,transparent,#fff 18%,#fff 82%,transparent);transform:scaleX(0);transform-origin:left;animation:rollProgress .9s linear forwards;z-index:2;box-shadow:0 0 8px #fff}
@keyframes rollProgress{to{transform:scaleX(1)}}
.dice.rolling{animation:roll .38s infinite alternate;filter:drop-shadow(0 0 15px #9d7aff)}@keyframes roll{from{transform:rotate(-12deg) scale(.95)}to{transform:rotate(12deg) scale(1.04)}}.result-name{font-size:23px;font-weight:900;margin:6px}.rarity{display:inline-block;border-radius:999px;padding:4px 10px;font-size:12px;background:#252b46;color:#dce1ff;border:1px solid #454d7a}.result-sub{font-size:13px;color:var(--muted);min-height:22px}.roll-actions{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:18px}.roll-actions button{min-width:125px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:20px 0 12px}.section-head h2{font-size:18px;margin:0}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.item{background:#121729;border:1px solid var(--line);border-radius:15px;padding:13px;min-width:0;position:relative;overflow:hidden}.item .ico{font-size:31px}.item h3{font-size:14px;margin:6px 0 1px;overflow-wrap:anywhere}.item p{font-size:12px;color:var(--muted);margin:2px 0}.item .count{position:absolute;right:10px;top:10px;font-size:12px;color:var(--cyan)}
/* 圖鑑採用一行一項，稀有度顏色依骰子設定呈現 */
.codex-list{display:flex;flex-direction:column;gap:7px;margin-top:14px}
.codex-row{display:grid;grid-template-columns:minmax(82px,125px) 1fr auto;align-items:center;gap:12px;padding:11px 14px;background:linear-gradient(100deg,#121729,#0f1423);border:1px solid var(--line);border-left:4px solid var(--rarity-color,#8c96b8);border-color:color-mix(in srgb,var(--rarity-color,#8c96b8) 38%,#29304b);background:linear-gradient(100deg,color-mix(in srgb,var(--rarity-color,#8c96b8) 12%,#121729),#0f1423 72%);border-radius:12px;min-width:0}
.codex-chance{font-weight:900;color:var(--rarity-color,#c5cbe0);font-variant-numeric:tabular-nums;white-space:nowrap}
.codex-name{font-weight:750;min-width:0;overflow-wrap:anywhere}
.codex-icon{font-size:20px;color:var(--rarity-color,#c5cbe0);margin-right:7px}
.codex-row.missing{opacity:1;filter:brightness(.64)}
.codex-row .codex-count{font-size:12px;color:var(--muted);white-space:nowrap}
@media(max-width:480px){.codex-row{grid-template-columns:88px minmax(0,1fr) auto;gap:7px;padding:10px}.codex-chance{font-size:13px}.codex-name{font-size:13px}.codex-icon{margin-right:3px}}.sell-row{display:grid;grid-template-columns:minmax(82px,110px) minmax(0,1fr) minmax(64px,82px) auto;align-items:center;gap:8px;padding:8px 10px;border:1px solid color-mix(in srgb,var(--rarity-color) 35%,#29304b);border-left:3px solid var(--rarity-color);border-radius:10px;background:linear-gradient(100deg,color-mix(in srgb,var(--rarity-color) 9%,#121729),#0f1423 75%);font-size:13px}.sell-row button{padding:6px 9px;font-size:12px;white-space:nowrap}.sell-qty{width:100%;min-width:0;background:#0b1020;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:6px}.sell-row small{font-size:11px}.sell-help{font-size:12px;margin:4px 0 8px;color:var(--muted)}@media(max-width:480px){.sell-row{grid-template-columns:78px minmax(0,1fr) 55px;gap:6px;padding:8px}.sell-row button{grid-column:2/4;justify-self:stretch}.sell-row .inventory-chance{font-size:11px}.sell-row .inventory-dice{font-size:12px}}.toolbar label{font-size:13px;color:var(--muted)}
#inventoryGrid{display:flex;flex-direction:column;gap:8px}.inventory-row{display:grid;grid-template-columns:minmax(100px,150px) minmax(0,1fr) auto;align-items:center;gap:10px;padding:13px 15px;border:1px solid color-mix(in srgb,var(--rarity-color) 42%,#29304b);border-left:4px solid var(--rarity-color);border-radius:12px;background:linear-gradient(100deg,color-mix(in srgb,var(--rarity-color) 13%,#121729),#0f1423 75%);min-width:0}.inventory-chance{font-weight:900;color:var(--rarity-color);font-variant-numeric:tabular-nums;white-space:nowrap}.inventory-dice{min-width:0;overflow-wrap:anywhere;font-weight:750}.inventory-count{color:var(--rarity-color);white-space:nowrap}.inventory-sell{display:flex;align-items:center;gap:5px;grid-column:1/-1;justify-content:flex-end}.inventory-sell input{width:68px;min-width:0;background:#0b1020;color:var(--text);border:1px solid var(--line);border-radius:7px;padding:5px}.inventory-sell button{padding:5px 9px;font-size:12px}@media(max-width:480px){.inventory-row{grid-template-columns:100px minmax(0,1fr) auto;gap:7px;padding:11px 9px;font-size:13px}.inventory-chance{font-size:12px}}
.item.rare{border-color:#5b477c;box-shadow:inset 0 0 18px #a06cff0b}.item.ultra{border-color:#8c6b39;box-shadow:inset 0 0 24px #ffd27a12}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.toolbar input,.toolbar select,.field{background:#0b1020;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:10px;min-width:0}.toolbar input{flex:1;min-width:130px}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.glove-panel .card{padding:18px}.glove-panel .recipe{align-items:flex-start;padding:15px;margin:12px 0}.glove-panel .recipe button{align-self:center;min-width:76px}.glove-panel .stats{gap:8px}.glove-panel .stat{text-align:center}.glove-panel #recipeList{display:flex;flex-direction:column;gap:8px}.glove-panel .notice{line-height:1.7}.recipe{display:flex;justify-content:space-between;gap:10px;align-items:center;margin:10px 0;padding:13px;background:#101528;border:1px solid var(--line);border-radius:14px}.recipe h3{margin:0 0 3px;font-size:15px}.recipe p{margin:0;color:var(--muted);font-size:12px}.potion-recipe-flow{display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin:7px 0}.potion-recipe-slot{flex:1 1 78px;min-width:68px;max-width:125px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:3px;padding:7px 5px;border:1px solid var(--line);border-radius:10px;background:linear-gradient(145deg,#171d34,#0b1020)}.potion-recipe-slot .slot-icon{font-size:22px;line-height:1.1}.potion-recipe-slot .slot-name{font-size:10px;font-weight:800;overflow-wrap:anywhere}.potion-recipe-slot .slot-odds{font-size:10px;color:var(--muted)}.potion-recipe-slot .slot-qty{font-size:10px;font-weight:800;color:var(--cyan)}.potion-dice-icons{display:flex;align-items:center;justify-content:center;gap:3px;flex-wrap:wrap;min-height:23px}.potion-dice-icons .slot-icon{font-size:19px!important}.potion-recipe-arrow{align-self:center;color:var(--purple);font-size:16px;font-weight:900;padding:0 1px}.potion-result-slot{border-color:#6b5c9f;background:linear-gradient(145deg,#292046,#111426)}.potion-material-status{font-size:10px!important;margin-top:3px!important}.potion-action-buttons{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
/* 藥水工坊重新排版：資訊、材料與操作分區，手機也容易閱讀 */
#potionList{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:stretch}
#potionList>.potion-card{display:flex;flex-direction:column;gap:10px;margin:0!important;padding:15px;border:1px solid #303956;border-radius:16px;background:linear-gradient(155deg,#171d32,#0d1220 78%);min-width:0;box-shadow:0 8px 24px #0002}
.potion-card-head{display:flex;align-items:flex-start;gap:10px;min-width:0}
.potion-card-icon{display:grid;place-items:center;flex:0 0 46px;width:46px;height:46px;border-radius:13px;background:#242541;border:1px solid #4b4776;font-size:25px}
.potion-card-title{min-width:0;flex:1}.potion-card-title h3{margin:1px 0 4px;font-size:15px}.potion-card-title p{margin:0;line-height:1.5;font-size:12px;color:var(--muted)}
.potion-owned{flex:0 0 auto;padding:5px 8px;border:1px solid #3a4567;border-radius:999px;font-size:11px;color:#d9ddff;white-space:nowrap}
.potion-section-label{font-size:11px;font-weight:800;letter-spacing:.08em;color:#aeb8dc;margin-bottom:6px}
.potion-recipe-flow{display:grid;grid-template-columns:minmax(0,1fr) 18px minmax(78px,.75fr);align-items:stretch;gap:5px;margin:0}
.potion-materials{display:flex;gap:6px;min-width:0;flex-wrap:wrap}
.potion-recipe-slot{flex:1 1 72px;min-width:0;max-width:none;padding:8px 5px;border-radius:10px}
.potion-recipe-slot .slot-name{font-size:10px;line-height:1.35}.potion-recipe-slot .slot-odds,.potion-recipe-slot .slot-qty,.potion-recipe-slot .potion-material-status{font-size:10px;line-height:1.35}
.potion-recipe-arrow{display:grid;place-items:center;padding:0;font-size:15px}
.potion-result-slot{min-width:0;flex:1 1 auto}
.potion-cost{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 10px;border-radius:9px;background:#0b1020;font-size:12px}.potion-cost strong{color:#ffd166;font-size:14px}
.potion-action-buttons{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:auto!important}.potion-action-buttons button{min-width:0;padding:9px 7px;font-size:12px}.potion-action-buttons [data-toggle-auto-add]{grid-column:1/-1}
@media(max-width:620px){#potionList{grid-template-columns:1fr;gap:10px}.potion-card-head{gap:9px}.potion-card-icon{width:42px;height:42px;flex-basis:42px}.potion-recipe-slot{flex-basis:68px}.potion-action-buttons button{font-size:12px}}
.potion-auto-add.active{border-color:#397e6c;background:#17352f;color:#8ff0ca}@media(max-width:480px){.potion-recipe-flow{gap:4px}.potion-recipe-slot{flex-basis:68px;min-width:62px;padding:6px 4px}.potion-recipe-slot .slot-icon{font-size:20px}.potion-dice-icons .slot-icon{font-size:17px!important}.potion-recipe-arrow{font-size:14px}}.bag-upgrade-strip{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;padding:9px 12px;border:1px solid #485a91;background:linear-gradient(100deg,#151c35,#101528);border-radius:12px}.bag-upgrade-strip b{font-size:13px;color:#dce4ff}.bag-upgrade-strip .mini{margin-top:2px}#upgradeBagBtn{box-shadow:0 0 0 1px #8d9dff33;flex-shrink:0}.bag-upgrade-strip button:disabled{opacity:.75;cursor:default}.rarity-overlay{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;background:rgba(3,4,12,.96);padding:20px;overflow:hidden}.rarity-overlay.show{display:flex}.rarity-overlay.blackout{background:#000}.rarity-overlay.blackout .rarity-reveal-card,.rarity-overlay.blackout .rarity-particles{visibility:hidden}.rarity-reveal-card{position:relative;z-index:2;text-align:center;min-width:min(320px,90vw);padding:28px 24px;border:1px solid var(--reveal-color,#fff);border-radius:24px;background:radial-gradient(ellipse at 50% 0%,color-mix(in srgb,var(--reveal-color,#fff) 24%,transparent),#101323 70%);box-shadow:0 0 70px color-mix(in srgb,var(--reveal-color,#fff) 45%,transparent);animation:revealPop .75s cubic-bezier(.2,1.5,.4,1) both}.rarity-reveal-icon{font-size:86px;line-height:1.25;filter:drop-shadow(0 0 24px var(--reveal-color,#fff));animation:revealSpin 1.8s ease-in-out infinite alternate}.rarity-reveal-title{font-size:12px;letter-spacing:.28em;color:var(--reveal-color,#fff);margin:10px 0}.rarity-reveal-name{font-size:clamp(22px,5vw,32px);font-weight:900;margin:8px 0}.rarity-reveal-odds{font-size:16px;color:var(--reveal-color,#fff);font-weight:800}.rarity-particles{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--reveal-color,#fff) 25%,transparent),transparent 38%);animation:particlePulse 1s ease-in-out infinite alternate}.rarity-overlay.common .rarity-reveal-card{animation:revealPop .5s ease-out both}.rarity-overlay.common .rarity-reveal-icon{animation:revealSpin .7s ease-in-out infinite alternate}@keyframes revealPop{0%{opacity:0;transform:scale(.25) rotate(-12deg);filter:blur(12px)}70%{opacity:1;transform:scale(1.08) rotate(2deg);filter:blur(0)}100%{transform:scale(1)}}@keyframes revealSpin{from{transform:rotate(-9deg) scale(.94)}to{transform:rotate(9deg) scale(1.06)}}@keyframes particlePulse{from{opacity:.25;transform:scale(.8)}to{opacity:1;transform:scale(1.15)}}@media(prefers-reduced-motion:reduce){.rarity-reveal-card,.rarity-reveal-icon,.rarity-particles{animation:none!important}}
.bar{height:7px;border-radius:20px;background:#252c45;overflow:hidden;margin-top:9px}.bar span{height:100%;display:block;background:linear-gradient(90deg,#7285ff,#bd85ff)}.notice{padding:12px 14px;border:1px solid #67532c;background:#2a2418;border-radius:12px;color:#f4dca7;font-size:13px;margin-bottom:14px}.empty{border:1px dashed #343d5d;border-radius:14px;text-align:center;padding:26px;color:var(--muted)}.footer{color:#707b9b;font-size:11px;text-align:center;padding:24px 8px}.toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,20px);background:#252d4a;border:1px solid #5968a3;border-radius:12px;padding:11px 16px;opacity:0;pointer-events:none;transition:.2s;z-index:20;max-width:90vw}.toast.show{opacity:1;transform:translate(-50%,0)}.mobile-nav{display:none}.mini{font-size:11px;color:var(--muted)}.highlight{color:var(--cyan)}.adminbox{border:1px solid #65454f;background:#1b121d;border-radius:14px;padding:14px}.admin-player{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.admin-player:last-child{border-bottom:0}.admin-online{color:#65e6b2}.admin-offline{color:#8790aa}.admin-log{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;padding:10px 0;border-bottom:1px solid var(--line)}.admin-log:last-child{border-bottom:0}
@media(max-width:760px){.shell{padding:10px}.top{padding-bottom:12px}.layout{display:block}.nav{display:none}.mobile-nav{display:flex;position:sticky;top:0;z-index:10;gap:5px;overflow-x:auto;background:#090c18ee;border:1px solid var(--line);border-radius:14px;padding:6px;margin-bottom:12px;backdrop-filter:blur(12px)}.mobile-nav button{white-space:nowrap;padding:8px 11px;font-size:12px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two{grid-template-columns:1fr}.hero{padding:17px}.stats{gap:7px}.stat{padding:11px}.stat b{font-size:18px}.dice{width:112px;height:112px;font-size:58px}.profile .pill{display:none}.roll-actions button{flex:1;min-width:105px}.brand{font-size:18px}}
[hidden]{display:none!important}</style></head>
<body><div class="shell">
<header class="top"><div class="brand">骰界 <span>RNG</span></div><div class="profile"><span class="pill" id="saveStatus">本機試玩存檔</span><div class="avatar" id="avatar">旅</div><div><b id="playerName">旅人</b><div class="mini" id="gloveLabel">基礎手套</div></div><button class="quiet" id="nameBtn">改名</button><button class="primary" id="authOpenBtn">登入／註冊</button><button class="quiet" id="authLogoutBtn" hidden>登出</button></div></header>
<div class="mobile-nav" id="mobileNav"></div><div class="layout"><aside class="nav" id="sideNav"></aside><main class="content">
<section class="page active" id="page-roll">
<div class="hero"><div class="eyebrow">WELCOME TO THE DICE REALM</div><h1>命運，由你擲出。</h1><div class="muted">收集未知骰子、鍛造手套，突破你的收藏極限。</div></div>
<div class="stats"><div class="stat"><b id="totalRolls">0</b><span>累積擲骰</span></div><div class="stat"><b id="uniqueCount">0 / 24</b><span>已發現骰子</span></div><div class="stat"><b id="luckStat">+0%</b><span>額外運氣</span></div></div>
<div class="rollbox"><div class="eyebrow">ROLL THE UNKNOWN</div><div class="dice" id="diceFace">⚄</div><div class="result-name" id="resultName">等待命運</div><span class="rarity" id="resultRarity">按下擲骰開始</span><div class="result-sub" id="resultSub">每一次擲骰，都可能帶來新的發現。</div><div class="roll-actions"><button class="primary" id="rollBtn">✦ 擲骰</button><button id="autoBtn">▶ 自動擲骰</button><button class="quiet" id="stopBtn" disabled>停止</button></div></div>
<div class="card" style="margin-top:8px"><div class="section-head" style="margin:0 0 8px"><h2>背包與自動出售</h2><span class="pill" id="bagCapacity">0 / 35 顆</span></div><div class="toolbar"><label for="autoSellThreshold">自動出售比此機率更常見的骰子</label><select id="autoSellThreshold"><option value="0">關閉自動出售</option><option value="2">保留 1/2 及更稀有</option><option value="4">保留 1/4 及更稀有</option><option value="8">保留 1/8 及更稀有</option><option value="16">保留 1/16 及更稀有</option><option value="32">保留 1/32 及更稀有</option><option value="64">保留 1/64 及更稀有</option><option value="128">保留 1/128 及更稀有</option><option value="256">保留 1/256 及更稀有</option><option value="512">保留 1/512 及更稀有</option><option value="1024">保留 1/1024 及更稀有</option><option value="2048">保留 1/2048 及更稀有</option></select></div><div class="stats"><div class="stat"><b id="coinBalance">0€</b><span>出售收入</span></div><div class="stat"><b id="bagTotal">0 / 35</b><span>背包骰子數</span></div><div class="stat"><b id="autoSoldCount">0</b><span>自動出售數量</span></div></div></div>

</section>
<section class="page" id="page-inventory"><div class="section-head"><h2>骰子背包</h2><span class="pill" id="bagCount">0 種</span></div><p class="muted" style="margin:0 0 12px">只顯示目前背包持有的骰子，可直接選擇出售數量。</p><div class="bag-upgrade-strip"><div><b>背包容量擴充</b><div class="mini" id="bagUpgradeInfo">目前容量 35，最高 100 顆</div></div><button class="primary" id="upgradeBagBtn" style="padding:6px 10px;font-size:12px;min-height:30px;white-space:nowrap">擴充 +1</button></div><div class="grid" id="inventoryGrid" style="margin-top:12px"></div></section>
<section class="page" id="page-codex"><div class="section-head"><h2>收藏圖鑑</h2><span class="pill" id="codexPct">0%</span></div><div class="hero"><div class="eyebrow">ARCHIVE DATABASE</div><h1>記錄每一次奇蹟。</h1><div class="muted">未發現的骰子將以未知檔案顯示。部分高階骰子擁有專屬視覺。</div><div class="bar"><span id="codexBar" style="width:0%"></span></div></div><div class="codex-list" id="codexGrid"></div></section>
<section class="page" id="page-gloves"><div class="glove-panel"><div class="section-head"><h2>手套工坊</h2><span class="pill">合成與裝備</span></div><div class="notice">合成會消耗指定材料。請確認背包數量後再製作；目前原型會將進度保存在這台裝置。</div><div class="two"><div class="card"><div class="eyebrow">EQUIPPED GLOVE</div><div style="font-size:48px;margin:12px 0">🧤</div><h2 id="equippedName">基礎手套</h2><p class="muted" id="equippedDesc">沒有額外加成，冒險從這裡開始。</p><div class="stats"><div class="stat"><b id="gloveLuck">+0%</b><span>運氣</span></div><div class="stat"><b id="gloveSpeed">+0%</b><span>擲骰速度</span></div><div class="stat"><b id="gloveOwned">1</b><span>持有手套</span></div></div></div><div class="card"><h3 style="margin-top:0">合成配方</h3><p class="muted">收集材料解鎖更強的裝備。</p><div id="recipeList"></div></div></div></div></section>
<section class="page" id="page-potions"><div class="section-head"><h2>藥水工坊</h2><span class="pill">運氣增幅</span></div><div class="hero"><div class="eyebrow">POTION LAB</div><h1>改變下一次命運。</h1><div class="muted">運氣藥水效果持續 5 分鐘；天堂藥水大幅提升下一抽的運氣。運氣藥水與運氣藥水效果不會疊加，使用另一瓶限時藥水會取代目前效果。</div><div class="stats"><div class="stat"><b id="potionLuckNow">+0%</b><span>目前運氣加成</span></div><div class="stat"><b id="potionTimer">未啟用</b><span>剩餘時間</span></div><div class="stat"><b id="angelCount">0</b><span>天堂藥水可用次數</span></div></div><p id="potionStatus" class="muted">尚未使用藥水。</p></div><div class="card" style="margin-top:12px"><div class="section-head" style="margin:0 0 8px"><h3>自動添加材料</h3><span class="pill" id="potionMaterialCount">0 / 2 種</span></div><p class="mini">最多選擇 2 種骰子自動收集；藥水工坊的材料保留總量最多 4 顆，達上限後不再添加。</p><div id="potionAutoAddChoices" class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:8px"></div><p class="mini">目前材料：<b id="potionMaterialTotal">0 / 4 顆</b></p></div><div id="potionList" style="margin-top:12px"></div><p class="mini">運氣會改變骰子抽取權重，因此加成期間實際中獎率會不同於骰子原始標示機率。所有擲骰（手動與自動）都使用同一套計算。</p></section>
<section class="page" id="page-quests"><div class="section-head"><h2>任務與成就</h2><span class="pill">每日更新：原型版暫用本機日期</span></div><div class="two"><div class="card"><h3>今日任務</h3><p class="muted">完成全部 3 項每日任務，可獲得 888€。</p><div id="questList"></div></div><div class="card"><h3>成就檔案</h3><p class="muted">里程碑將記錄在你的個人資料。</p><div id="achievementList"></div></div></div></section>
<section class="page" id="page-profile"><div class="section-head"><h2>玩家資料</h2></div><div class="hero"><div class="eyebrow">PLAYER DOSSIER</div><h1 id="profileName">旅人</h1><div class="muted" id="joined">加入時間：—</div><div class="stats"><div class="stat"><b id="profileRolls">0</b><span>總擲骰數</span></div><div class="stat"><b id="profileUnique">0</b><span>收藏種類</span></div><div class="stat"><b id="profileGloves">1</b><span>手套數量</span></div></div></div><div class="section-head"><h2>最高紀錄</h2></div><div class="card" id="bestRecord">尚無紀錄</div><div class="section-head"><h2>個人設定</h2></div><div class="card"><label>玩家名稱</label><div class="toolbar" style="margin-top:8px"><input id="profileNameInput" maxlength="20" placeholder="輸入名稱"><button class="primary" id="saveName">儲存名稱</button></div><p class="mini">本機原型：名稱與進度儲存在目前瀏覽器。</p><button class="danger" id="resetBtn">重設本機試玩資料</button></div></section>
<section class="page" id="page-leaderboard"><div class="section-head"><h2>全服排行榜</h2><button class="primary" id="refreshLeaderboardBtn">↻ 重新整理</button></div><div class="notice">排行榜會同步已登入玩家的雲端資料。擲骰榜依累積擲骰次數排名；稀有榜依玩家獲得過的最高稀有度排名（分母越大越稀有）。登入並遊玩後，存檔同步時會更新榜單。</div><div class="two"><div class="card"><h3>🎲 累積擲骰 TOP 10</h3><p class="muted">總擲骰次數越多，排名越前</p><div id="localRank"><div class="empty">正在載入排行榜…</div></div></div><div class="card"><h3>✦ 最稀有骰子 TOP 10</h3><p class="muted">顯示玩家目前紀錄中最稀有的骰子</p><div id="rareRank"><div class="empty">正在載入排行榜…</div></div></div></div></section>
<section class="page" id="page-admin" hidden><div class="section-head"><h2>管理員面板</h2><button class="primary" id="adminRefreshBtn">重新整理</button></div><div class="notice">此面板只對指定管理員帳號顯示，所有管理操作仍由 Supabase 雲端驗證權限。</div><div class="two"><div class="card"><h3 style="margin-top:0">全體玩家發放</h3><label for="adminGrantType">發放項目</label><select id="adminGrantType" class="field" style="width:100%;margin:7px 0 12px"><option value="coins">遊戲幣 (€)</option><option value="potion">指定藥水</option></select><div id="adminPotionSelectWrap" hidden><label for="adminPotionId">藥水種類</label><select id="adminPotionId" class="field" style="width:100%;margin:7px 0 12px"><option value="luck1">運氣藥水 I</option><option value="luck2">運氣藥水 II</option><option value="luck3">運氣藥水 III</option><option value="angel1">天堂藥水 I</option></select></div><label for="adminGrantAmount">每位玩家發放數量</label><input id="adminGrantAmount" type="number" min="1" max="1000000000" value="100" class="field" style="width:100%;margin:7px 0 12px"><button class="primary" id="adminGrantBtn" style="width:100%">發放給全體玩家</button><p class="mini">執行前會再次確認，並記錄管理操作。</p><p id="adminMessage" class="muted" role="status"></p></div><div class="card"><h3 style="margin-top:0">玩家在線狀況</h3><div class="stats"><div class="stat"><b id="adminPlayerCount">0</b><span>玩家總數</span></div><div class="stat"><b id="adminOnlineCount">0</b><span>目前在線</span></div></div><div id="adminPlayers"><div class="empty">正在載入玩家狀況…</div></div></div></div><div class="card" style="margin-top:12px"><h3 style="margin-top:0">最近合成紀錄</h3><p class="muted">顯示全體玩家最近 100 筆手套／藥水合成紀錄。</p><div id="adminCraftLogs"><div class="empty">正在載入合成紀錄…</div></div></div></section>

</main></div></div><div class="toast" id="toast"></div><div id="rarityOverlay" class="rarity-overlay" aria-live="assertive"><div class="rarity-particles"></div><div class="rarity-reveal-card"><div class="rarity-reveal-title" id="rarityRevealTitle">RARE DISCOVERY</div><div class="rarity-reveal-icon" id="rarityRevealIcon">✦</div><div class="rarity-reveal-name" id="rarityRevealName">稀有骰子</div><div class="rarity-reveal-odds" id="rarityRevealOdds">1/10000</div></div></div>
<div id="authModal" style="display:none;position:fixed;inset:0;z-index:100;background:#050711dd;backdrop-filter:blur(10px);padding:18px;overflow:auto;align-items:center;justify-content:center">
 <div class="card" style="width:min(100%,440px);padding:22px;border-color:#454d7a;box-shadow:0 25px 90px #0009">
  <div class="eyebrow">DICE REALM ACCOUNT</div><h2 style="margin:5px 0 4px">登入雲端帳號</h2><p class="muted" style="font-size:13px">使用 Email 與密碼登入，將骰子收藏同步到雲端。首次註冊需先到信箱確認身分，點擊驗證信後即可返回遊戲。</p>
  <label for="authEmail">Gmail／Email</label><input id="authEmail" type="email" autocomplete="email" placeholder="name@gmail.com" class="field" style="width:100%;margin:6px 0 12px">
  <label for="authPassword">密碼（至少 6 位）</label><input id="authPassword" type="password" autocomplete="current-password" placeholder="輸入密碼" class="field" style="width:100%;margin:6px 0 14px">
  <div class="toolbar"><button class="primary" id="authLoginBtn" style="flex:1">登入</button><button id="authSignupBtn" style="flex:1">註冊</button></div>
  <button class="quiet" id="authResetBtn" style="width:100%;margin-top:8px">忘記密碼</button><p id="authMessage" class="muted" role="status" style="font-size:13px;margin:12px 0 0"></p>
  <button class="quiet" id="authCloseBtn" style="width:100%;margin-top:12px">稍後再說</button>
 </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const D=[
{id:'d1',name:'初始骰子',den:2,icon:'⚄',color:'#aeb8d8',desc:'最常見的命運碎片。',effect:'微光'},
{id:'d2',name:'微光骰子',den:4,icon:'✧',color:'#c4d2ff',desc:'微弱光點在骰面流動。',effect:'微光'},
{id:'d3',name:'潮汐骰子',den:8,icon:'◈',color:'#70d8ff',desc:'像海潮般起伏的藍色能量。',effect:'潮汐'},
{id:'d4',name:'月影骰子',den:16,icon:'☾',color:'#9ca8ff',desc:'收集月光的古老骰子。',effect:'月影'},
{id:'d5',name:'星塵骰子',den:32,icon:'✦',color:'#bba2ff',desc:'星塵在透明骰面內旋轉。',effect:'星塵'},
{id:'d6',name:'霜晶骰子',den:64,icon:'❄',color:'#9cf3ff',desc:'冰晶紋路透出冷冽光芒。',effect:'霜晶'},
{id:'d7',name:'幻影骰子',den:128,icon:'◇',color:'#d2a0ff',desc:'輪廓會在空氣中留下殘影。',effect:'幻影'},
{id:'d8',name:'雷鳴骰子',den:256,icon:'ϟ',color:'#ffe17c',desc:'金色電弧沿著稜角跳躍。',effect:'雷電'},
{id:'d9',name:'深海骰子',den:512,icon:'♆',color:'#65c8ff',desc:'深海中的藍色光芒。',effect:'深海'},
{id:'d10',name:'極光骰子',den:1024,icon:'✺',color:'#75ffd8',desc:'綠紫極光在骰子周圍流轉。',effect:'極光'},
{id:'d11',name:'裂隙骰子',den:2048,icon:'⌬',color:'#bd8aff',desc:'空間裂縫在骰面短暫閃現。',effect:'裂隙'},
{id:'d12',name:'彗星骰子',den:4096,icon:'☄',color:'#ff9d8b',desc:'拖著彗尾穿越暗色星空。',effect:'彗星'},
{id:'d13',name:'日冕骰子',den:8192,icon:'☼',color:'#ffc96f',desc:'微型日冕向外迸發。',effect:'日冕'},
{id:'d14',name:'虛空骰子',den:16384,icon:'◉',color:'#b18aff',desc:'黑暗中心吞沒周圍的光。',effect:'黑洞'},
{id:'d15',name:'時序骰子',den:32768,icon:'⌛',color:'#8de7ff',desc:'細小的時間刻度環繞骰面。',effect:'時序'},
{id:'d16',name:'混沌骰子',den:65536,icon:'※',color:'#ff85d1',desc:'無序符文不斷重新排列。',effect:'混沌'},
{id:'d17',name:'天體骰子',den:131072,icon:'🪐',color:'#8daaff',desc:'微型行星沿軌道運行。',effect:'天體'},
{id:'d18',name:'星爆骰子',den:262144,icon:'✹',color:'#ffdb87',desc:'耀眼星爆在暗處綻放。',effect:'星爆'},
{id:'d19',name:'維度骰子',den:524288,icon:'⟡',color:'#a6a0ff',desc:'多層維度重疊成不可能的形狀。',effect:'維度'},
{id:'d20',name:'奇點骰子',den:1048576,icon:'●',color:'#e2a5ff',desc:'奇點周圍的光線向內彎曲。',effect:'奇點'},
{id:'d21',name:'創世骰子',den:2097152,icon:'✺',color:'#fff0a1',desc:'像宇宙誕生般的明亮脈衝。',effect:'創世'},
{id:'d22',name:'永夜骰子',den:4194304,icon:'☽',color:'#8b91ff',desc:'深邃永夜中只有一道光。',effect:'永夜'},
{id:'d23',name:'終焉骰子',den:8388608,icon:'♜',color:'#ff829d',desc:'紅色裂紋與終末粒子。',effect:'終焉'},
{id:'d24',name:'原初骰子',den:33554432,icon:'✹',color:'#ffffff',desc:'超越常規的原初能量，極其罕見。',effect:'原初'},
{id:'d25',name:'深紅',den:10000000,icon:'✹',color:'#8f1238',desc:'深紅色奇點撕開機率的邊界。',effect:'深紅'},
{id:'d26',name:'星核骰子',den:20480000,icon:'✦',color:'#ff4dff',desc:'高密度星核釋放耀眼的洋紅脈衝。',effect:'星核'},
{id:'d27',name:'終極界限骰子',den:49999999,icon:'⬡',color:'#a6ff00',desc:'逼近五千萬分之一的極限稀有骰子。',effect:'界限'},
{id:'d28',name:'裂光骰子',den:2500,icon:'✧',color:'#ffb86b',desc:'一道金色裂光沿著骰面迅速劃過。',effect:'裂光'},
{id:'d29',name:'時空座標骰子',den:99999,icon:'⌖',color:'#70f0e0',desc:'顯示不存在於任何星圖中的座標。',effect:'座標'},
{id:'d30',name:'超新星骰子',den:1000000,icon:'✹',color:'#ffdc70',desc:'恆星在骰面內坍縮，隨即爆發。',effect:'超新星'},
{id:'d31',name:'異常座標骰子',den:24681012,icon:'⟁',color:'#ff70c8',desc:'一組無法解讀的數字撕開機率邊界。',effect:'異常座標'},
{id:'d32',name:'骰界核心',den:75000000,icon:'⬢',color:'#f5f7ff',desc:'骰界深處的核心，幾乎不可能被發現。',effect:'骰界核心'}
 ];
// 圖鑑依稀有度區間統一配色：同一階級同色，階級越高色相越突出。
function rarityColor(den){
 if(den<=512) return '#63c9ff';              // 1/2～1/512：藍色
 if(den<=32768) return '#65e6b2';            // 1/1,024～1/32,768：青綠色
 if(den<=524288) return '#b99aff';           // 1/65,536～1/524,288：紫色
 if(den<=8388608) return '#ff829d';          // 1/1,048,576～1/8,388,608：玫瑰色
 if(den>=10000000 && den<=35000000) return '#ffd166'; // 1,000萬～3,500萬：金色
 if(den===49999999) return '#b7ff45';        // 近5,000萬：螢光綠
 return '#ffffff';
}
D.forEach(d=>d.color=rarityColor(d.den));
const G=[
{id:'g0',name:'基礎手套',icon:'🧤',luck:0,speed:0,desc:'沒有額外加成，冒險從這裡開始。',recipe:[]},
{id:'g1',name:'運氣手套',icon:'🧤',luck:10,speed:10,desc:'讓命運稍微站在你這邊。',recipe:[['d11',1],['d12',1]]},
{id:'g2',name:'雷霆手套',icon:'⚡',luck:15,speed:22,desc:'電弧加速你的每一次擲骰。',recipe:[['d8',1],['d10',1],['d13',1]]},
{id:'g3',name:'虛空手套',icon:'🌌',luck:25,speed:15,desc:'從虛空中捕捉罕見的可能性。',recipe:[['d14',1],['d16',1],['d19',1]]},
{id:'g4',name:'宇宙手套',icon:'🪐',luck:40,speed:30,desc:'將星海的力量凝聚於掌心。',recipe:[['d17',1],['d20',1],['d21',1]]}
];
const KEY='diceRealmSave_v1';
const SUPABASE_URL='https://pkdctcfifauygnjipmab.supabase.co';
const SUPABASE_KEY='sb_publishable_1KaqGPbK2OVgXEvrVyM_7A_yQJBlrHC';
const supabaseClient=window.supabase?.createClient(SUPABASE_URL,SUPABASE_KEY,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true,storage:window.localStorage}});
let currentUser=null,cloudSyncTimer=null,cloudSyncBusy=false;
let S=load();let autoTimer=null,rolling=false;
function fresh(){return {name:'旅人',joined:new Date().toISOString(),rolls:0,bag:{},bagCapacity:35,first:{},gloves:{g0:1},equipped:'g0',best:null,coins:0,adminGrantApplied:{},autoSellThreshold:0,autoSold:0,potions:{inventory:{luck1:0,luck2:0,luck3:0,angel1:0},active:{type:'',expiresAt:0},angelCharges:0,autoAdd:false,materials:{}},questDate:new Date().toLocaleDateString('en-CA'),quest:{rolls:0,rare:0,craft:0,rewardClaimed:false},achievements:{}}}
function normalizeGloves(x){x.gloves=x.gloves||{g0:1};for(const id of Object.keys(x.gloves)){if(Number(x.gloves[id])>0)x.gloves[id]=1;else delete x.gloves[id]}x.gloves.g0=1;if(!G.some(g=>g.id===x.equipped)||!x.gloves[x.equipped])x.equipped='g0';return x}
function load(){try{let x=JSON.parse(localStorage.getItem(KEY));if(!x||!x.bag)return fresh();x=normalizeGloves(x);x.adminGrantApplied=x.adminGrantApplied||{};x.bagCapacity=Math.min(100,Math.max(35,Math.floor(Number(x.bagCapacity)||35)));x.potions=x.potions||{inventory:{},active:{type:'',expiresAt:0},angelCharges:0};x.potions.inventory=Object.assign({luck1:0,luck2:0,luck3:0,angel1:0},x.potions.inventory||{});x.potions.active=x.potions.active||{type:'',expiresAt:0};x.potions.angelCharges=Number(x.potions.angelCharges)||0;x.potions.autoAdd=!!x.potions.autoAdd;x.potions.materials=x.potions.materials||{};x.coins=Number(x.coins)||0;x.autoSellThreshold=Number(x.autoSellThreshold)||0;x.autoSold=Number(x.autoSold)||0;x.first=x.first||{};x.bag=x.bag||{};x.rollCounts=x.rollCounts||{};for(const id of Object.keys(x.bag)){if((Number(x.bag[id])||0)>0&&!x.first[id])x.first[id]=x.joined||new Date().toISOString()}return x}catch{return fresh()}}
function save(){localStorage.setItem(KEY,JSON.stringify(S));document.getElementById('saveStatus').textContent=currentUser?'雲端同步中…':'本機存檔';if(currentUser){clearTimeout(cloudSyncTimer);cloudSyncTimer=setTimeout(()=>syncCloudSave(),700)}}
function savePayload(){return {name:S.name,joined:S.joined,rolls:S.rolls,bag:S.bag,bagCapacity:S.bagCapacity,first:S.first,rollCounts:S.rollCounts||{},gloves:S.gloves,equipped:S.equipped,best:S.best,coins:S.coins,adminGrantApplied:S.adminGrantApplied||{},autoSellThreshold:S.autoSellThreshold,autoSold:S.autoSold,questDate:S.questDate,quest:S.quest,achievements:S.achievements,potions:S.potions}}
async function applyPendingGrants(){if(!currentUser||!supabaseClient)return false;S.adminGrantApplied=S.adminGrantApplied||{};S.potions=S.potions||fresh().potions;S.potions.inventory=Object.assign({luck1:0,luck2:0,luck3:0,angel1:0},S.potions.inventory||{});try{const {data,error}=await supabaseClient.from('player_grants').select('coins_total,luck1_total,luck2_total,luck3_total,angel1_total').eq('user_id',currentUser.id).maybeSingle();if(error)throw error;if(!data)return false;let changed=false;for(const col of ['coins_total','luck1_total','luck2_total','luck3_total','angel1_total']){const total=Math.max(0,Number(data[col])||0),applied=Math.max(0,Number(S.adminGrantApplied[col])||0),delta=Math.max(0,total-applied);if(delta>0){if(col==='coins_total')S.coins=(Number(S.coins)||0)+delta;else{const id=col.replace('_total','');S.potions.inventory[id]=(Number(S.potions.inventory[id])||0)+delta}changed=true}S.adminGrantApplied[col]=Math.max(applied,total)}if(changed)localStorage.setItem(KEY,JSON.stringify(S));return changed}catch(e){console.warn('Admin grant sync failed',e);return false}}
async function syncCloudSave(){if(!currentUser||!supabaseClient)return;if(cloudSyncBusy){clearTimeout(cloudSyncTimer);cloudSyncTimer=setTimeout(()=>syncCloudSave(),1200);return}cloudSyncBusy=true;const syncingUserId=currentUser.id;try{await applyPendingGrants();if(!currentUser||currentUser.id!==syncingUserId)return;const payload=savePayload();const now=new Date().toISOString();const {error}=await supabaseClient.from('game_saves').upsert({user_id:syncingUserId,save_data:payload,updated_at:now},{onConflict:'user_id'});if(error)throw error;const {error:profileError}=await supabaseClient.from('player_profiles').upsert({user_id:syncingUserId,username:(S.name||'旅人').trim().slice(0,20)||'旅人',total_rolls:Number(S.rolls)||0,unique_dice:totalUnique(),rarest_den:Number(S.best?.den)||0,coins:Number(S.coins)||0,last_seen:now,updated_at:now},{onConflict:'user_id'});if(profileError)throw profileError;document.getElementById('saveStatus').textContent='雲端已同步';if(document.getElementById('page-leaderboard')?.classList.contains('active'))refreshLeaderboards();}catch(e){console.error('Cloud sync failed',e);document.getElementById('saveStatus').textContent='雲端同步失敗';}finally{cloudSyncBusy=false}}
async function loadCloudSave(){if(!currentUser||!supabaseClient)return;try{const {data,error}=await supabaseClient.from('game_saves').select('save_data').eq('user_id',currentUser.id).maybeSingle();if(error)throw error;if(data?.save_data?.bag){S=normalizeGloves({...fresh(),...data.save_data});S.adminGrantApplied=S.adminGrantApplied||{};S.bagCapacity=Math.min(100,Math.max(35,Math.floor(Number(S.bagCapacity)||35)));S.potions=S.potions||fresh().potions;S.potions.inventory=Object.assign({luck1:0,luck2:0,luck3:0,angel1:0},S.potions.inventory||{});S.potions.active=S.potions.active||{type:'',expiresAt:0};S.potions.angelCharges=Number(S.potions.angelCharges)||0;S.potions.autoAdd=!!S.potions.autoAdd;S.potions.materials=S.potions.materials||{};{let left=4;for(const id of Object.keys(S.potions.materials)){const n=Math.max(0,Number(S.potions.materials[id])||0),keep=Math.min(n,left);if(keep)S.potions.materials[id]=keep;else delete S.potions.materials[id];left-=keep;}}S.potions.autoAddDice=Array.isArray(S.potions.autoAddDice)?S.potions.autoAddDice.slice(0,2):[];S.bag=S.bag||{};S.first=S.first||{};S.quest=S.quest||{rolls:0,rare:0,craft:0};S.achievements=S.achievements||{};localStorage.setItem(KEY,JSON.stringify(S));render();document.getElementById('saveStatus').textContent='雲端存檔已載入'}else{await syncCloudSave()}await applyPendingGrants();await syncCloudSave();await refreshLeaderboards()}catch(e){console.error(e);toast('讀取雲端存檔失敗，請重新登入');}}
function showAuthMessage(t){const e=document.getElementById('authMessage');if(e)e.textContent=t}
function openAuth(){document.getElementById('authModal').style.display='flex';showAuthMessage('')}
function closeAuth(){document.getElementById('authModal').style.display='none'}
async function authAction(mode){if(!supabaseClient){showAuthMessage('登入模組載入失敗，請重新整理網頁。');return}const email=document.getElementById('authEmail').value.trim(),password=document.getElementById('authPassword').value;if(!email||!/^\S+@\S+\.\S+$/.test(email)){showAuthMessage('請輸入有效的 Email 地址。');return}if(password.length<6&&mode!=='reset'){showAuthMessage('密碼至少需要 6 位。');return}showAuthMessage('處理中…');try{let result;if(mode==='signup')result=await supabaseClient.auth.signUp({email,password,options:{emailRedirectTo:location.href}});else if(mode==='login')result=await supabaseClient.auth.signInWithPassword({email,password});else result=await supabaseClient.auth.resetPasswordForEmail(email,{redirectTo:location.href});if(result.error)throw result.error;if(mode==='signup'&&!result.data.session){showAuthMessage('驗證信已送出！請到你的 Email 收信，確認「這是你本人嗎？」並點擊確認按鈕。完成驗證後會返回遊戲，畫面會提示你可以開始登入。若沒收到信，請檢查垃圾郵件匣。');return}if(mode==='reset'){showAuthMessage('若此 Email 已註冊，系統會寄出重設密碼信（需已設定可寄送給玩家的郵件服務）。');return}showAuthMessage('登入成功，正在載入雲端存檔…');}catch(e){showAuthMessage(e.message||'操作失敗，請稍後重試。')}}
async function refreshLeaderboards(){const local=document.getElementById('localRank'),rare=document.getElementById('rareRank');if(!local||!rare)return;if(!supabaseClient){local.innerHTML=rare.innerHTML='<div class="empty">雲端服務尚未載入，請重新整理。</div>';return}local.innerHTML=rare.innerHTML='<div class="empty">正在更新排行榜…</div>';try{const {data,error}=await supabaseClient.from('player_profiles').select('username,total_rolls,unique_dice,rarest_den,updated_at').order('total_rolls',{ascending:false}).limit(10);if(error)throw error;local.innerHTML=(data||[]).map((x,i)=>`<div class="recipe"><div style="min-width:0;flex:1"><h3>${i<3?['🥇','🥈','🥉'][i]:'#'+(i+1)} ${escapeHTML(x.username||'玩家')}</h3><p>已發現 ${format(x.unique_dice||0)} 種骰子</p></div><span class="pill">${format(x.total_rolls||0)} 次</span></div>`).join('')||'<div class="empty">目前還沒有排行榜資料，登入並擲骰後就會出現。</div>';const {data:rdata,error:rerror}=await supabaseClient.from('player_profiles').select('username,total_rolls,unique_dice,rarest_den,updated_at').gt('rarest_den',0).order('rarest_den',{ascending:false}).order('total_rolls',{ascending:false}).limit(10);if(rerror)throw rerror;rare.innerHTML=(rdata||[]).map((x,i)=>`<div class="recipe"><div style="min-width:0;flex:1"><h3>${i<3?['🥇','🥈','🥉'][i]:'#'+(i+1)} ${escapeHTML(x.username||'玩家')}</h3><p>累積擲骰 ${format(x.total_rolls||0)} 次</p></div><span class="pill">1/${format(x.rarest_den)}</span></div>`).join('')||'<div class="empty">還沒有人上傳稀有骰子紀錄。</div>'}catch(e){console.error('Leaderboard load failed',e);const msg=e?.message?`排行榜載入失敗：${escapeHTML(e.message)}`:'雲端排行榜暫時無法載入。';local.innerHTML=rare.innerHTML=`<div class="empty">${msg}</div>`}}
if(supabaseClient){supabaseClient.auth.onAuthStateChange((event,session)=>{currentUser=session?.user||null;document.getElementById('authOpenBtn').hidden=!!currentUser;document.getElementById('authLogoutBtn').hidden=!currentUser;updateAdminVisibility();if(currentUser){const user=currentUser;setTimeout(async()=>{if(!currentUser||currentUser.id!==user.id)return;if(S.name==='旅人'||!S.name){const base=(user.email||'玩家').split('@')[0].replace(/[^\p{L}\p{N}_-]/gu,'').slice(0,12)||'玩家';S.name=base+'_'+user.id.slice(0,4);localStorage.setItem(KEY,JSON.stringify(S));}document.getElementById('playerName').textContent=currentUser.email||S.name;closeAuth();if(event==='SIGNED_IN'&&user.email_confirmed_at){toast('信箱驗證成功！可以開始遊玩了。')}await loadCloudSave();if(currentUser?.id===user.id){await heartbeat();await refreshLeaderboards() }},0)}else{document.getElementById('saveStatus').textContent='本機存檔';}})}
async function heartbeat(){if(!currentUser||!supabaseClient)return;const user=currentUser;try{const now=new Date().toISOString();const {error}=await supabaseClient.from('player_profiles').upsert({user_id:user.id,username:(S.name||'旅人').trim().slice(0,20)||'旅人',total_rolls:Number(S.rolls)||0,unique_dice:totalUnique(),rarest_den:Number(S.best?.den)||0,coins:Number(S.coins)||0,last_seen:now,updated_at:now},{onConflict:'user_id'});if(error)throw error;const grantChanged=await applyPendingGrants();if(grantChanged)await syncCloudSave();}catch(e){console.debug('Presence update skipped',e)}}
setInterval(heartbeat,30000);
function byId(id){return D.find(x=>x.id===id)}
function glove(id){return G.find(x=>x.id===id)||G[0]}
function totalUnique(){return new Set([...Object.keys(S.first||{}),...Object.keys(S.bag||{}).filter(k=>S.bag[k]>0)]).size}
function totalDice(){return Object.values(S.bag).reduce((a,b)=>a+Math.max(0,Number(b)||0),0)}
function currentGlove(){return glove(S.equipped)}
const POTIONS=[
{id:'luck1',name:'運氣藥水 I',icon:'🧪',luck:10,duration:300000,cost:300,recipe:[['d5',2]],desc:'運氣 +10%，持續 5 分鐘。'},
{id:'luck2',name:'運氣藥水 II',icon:'⚗️',luck:20,duration:300000,cost:2500,recipe:[['d7',2],['d9',1]],desc:'運氣 +20%，持續 5 分鐘。'},
{id:'luck3',name:'運氣藥水 III',icon:'✦',luck:30,duration:300000,cost:15000,recipe:[['d11',2],['d14',1]],desc:'運氣 +30%，持續 5 分鐘。'},
{id:'angel1',name:'天堂藥水 I',icon:'🪽',luck:0,duration:0,cost:75000,recipe:[['d16',2],['d19',1]],desc:'大幅提升下一抽的運氣。'}
];
function activePotion(){const a=S.potions?.active;if(a&&a.type&&Number(a.expiresAt)>Date.now())return POTIONS.find(p=>p.id===a.type)||null;return null}
function potionLuck(){return activePotion()?.luck||0}
function luck(){return currentGlove().luck+potionLuck()}
function speed(){return currentGlove().speed}
function format(n){return n.toLocaleString('en-US')}
function escapeHTML(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function chanceText(d){return d.id==='d1'?'1/2':'1/'+format(d.den)}
function weightedRoll(){
 // 平衡型分級權重：普通骰子略降、中階稀有骰子提升，極稀有骰子只小幅提升。
 // 天堂藥水會讓下一抽只從 1/2048 或更稀有的骰子中抽取；圖鑑仍顯示各骰子的基礎稀有度。
 const angel=(Number(S.potions?.angelCharges)||0)>0;
 const effective=Math.max(0,Math.min(100,luck()));
 const eligible=angel?D.filter(d=>d.den>=2048):D;
 const weights=eligible.map(d=>{
  let factor;
  if(d.den<=1024) factor=1-effective*0.003;
  else if(d.den<=32768) factor=1+effective*0.006;
  else if(d.den<=1048576) factor=1+effective*0.0015;
  else factor=1+effective*0.0005;
  return (1/Math.max(2,d.den))*Math.max(0.1,factor);
 });
 const total=weights.reduce((a,b)=>a+b,0);let r=Math.random()*total;
 for(let i=0;i<eligible.length;i++){r-=weights[i];if(r<=0)return eligible[i]}
 return eligible[0];
}
function wait(ms){return new Promise(resolve=>setTimeout(resolve,ms))}
async function playRarityReveal(d){
 const overlay=document.getElementById('rarityOverlay');if(!overlay)return;
 const ultra=d.den>=100000;
 overlay.className='rarity-overlay show '+(ultra?'blackout':'common');
 overlay.style.setProperty('--reveal-color',d.color);
 document.getElementById('rarityRevealTitle').textContent=ultra?'✦ ANOMALOUS DISCOVERY ✦':'RARE DISCOVERY';
 document.getElementById('rarityRevealIcon').textContent=d.icon;
 document.getElementById('rarityRevealName').textContent=d.name;
 document.getElementById('rarityRevealOdds').textContent=chanceText(d);
 if(ultra){await wait(500);overlay.classList.remove('blackout');overlay.classList.add('show');await wait(2300)}else{await wait(1500)}
 overlay.classList.remove('show','blackout','common');
}
function doRoll(){
 if(rolling)return;
 if(totalDice()>=(Number(S.bagCapacity)||35)){go('inventory');toast('背包已滿，請先出售骰子或擴充容量');return}
 rolling=true;const face=document.getElementById('diceFace');face.classList.add('rolling');const rollButton=document.getElementById('rollBtn'),autoButton=document.getElementById('autoBtn');rollButton.classList.remove('roll-progress');autoButton.classList.remove('roll-progress');void rollButton.offsetWidth;rollButton.classList.add('roll-progress');rollButton.disabled=true;
 setTimeout(async()=>{
  const angelUsed=(Number(S.potions?.angelCharges)||0)>0;const d=weightedRoll(),now=new Date().toISOString(),isNew=!S.first[d.id]&&!S.bag[d.id];if(angelUsed)S.potions.angelCharges=Math.max(0,S.potions.angelCharges-1);
  S.rolls++;S.quest.rolls++;S.rollCounts=S.rollCounts||{};S.rollCounts[d.id]=(Number(S.rollCounts[d.id])||0)+1;
  if(!S.first[d.id])S.first[d.id]=now;
  const threshold=Number(S.autoSellThreshold)||0;
  let sold=false;
  if(S.potions?.autoAdd && (S.potions.autoAddDice||[]).includes(d.id) && potionMaterialTotal()<4){S.potions.materials=S.potions.materials||{};S.potions.materials[d.id]=(Number(S.potions.materials[d.id])||0)+1;}
  if(threshold>0 && d.den<threshold){S.coins=(Number(S.coins)||0)+d.den;S.quest.coinsEarned=(Number(S.quest.coinsEarned)||0)+d.den;S.autoSold=(Number(S.autoSold)||0)+1;sold=true;}
  else {S.bag[d.id]=(S.bag[d.id]||0)+1;}
  if(!S.best||d.den>S.best.den)S.best={id:d.id,den:d.den,time:now};
  if(d.den>=2048)S.quest.rare++;
  face.classList.remove('rolling');face.style.color=d.color;face.style.borderColor=d.color;face.style.boxShadow=`0 0 35px ${d.color}55,inset 0 0 24px ${d.color}20`;face.textContent=d.icon;
  document.getElementById('resultName').textContent=d.name;
  document.getElementById('resultRarity').textContent=chanceText(d);
  document.getElementById('resultSub').textContent=(sold?'已出售'+d.name+' +'+format(d.den)+'€':(isNew?'✦ 首次發現！':'獲得 ×'+S.bag[d.id]))+' · '+new Date(now).toLocaleTimeString();
  if(sold)toast('已出售'+d.name+' +'+format(d.den)+'€');else if(isNew)toast('新發現：'+d.name+'！');else if(d.den>=2048)toast('稀有發現：'+d.name);
  checkAchievements();checkDailyReward();if(d.den>=10000)await playRarityReveal(d);setTimeout(()=>{rolling=false;rollButton.classList.remove('roll-progress');autoButton.classList.remove('roll-progress');save();render()},250);
 },650);
}
function toast(t){let e=document.getElementById('toast');e.textContent=t;e.classList.add('show');clearTimeout(e._t);e._t=setTimeout(()=>e.classList.remove('show'),2100)}
const pages=[['roll','擲骰大廳','✦'],['inventory','骰子背包','▦'],['codex','收藏圖鑑','◈'],['gloves','手套工坊','♧'],['potions','藥水工坊','⚗'],['quests','任務成就','☷'],['leaderboard','排行榜','♜'],['profile','玩家資料','◎'],['admin','管理員面板','⚙']];
function isAdmin(){return (currentUser?.email||'').toLowerCase()==='toby110403@gmail.com'}
function updateAdminVisibility(){const allowed=isAdmin();document.querySelectorAll('[data-page="admin"]').forEach(b=>b.hidden=!allowed);const panel=document.getElementById('page-admin');panel.hidden=!allowed;if(!allowed&&panel.classList.contains('active'))go('roll')}
function navHTML(){return pages.map(([id,n,i])=>`<button data-page="${id}" data-nav-id="${id}" class="${id==='roll'?'active':''}" ${id==='admin'?'hidden':''}>${i} ${n}</button>`).join('')}
document.getElementById('sideNav').innerHTML='<small>GAME MENU</small>'+navHTML();document.getElementById('mobileNav').innerHTML=navHTML();
function go(id){if(id==='admin'&&!isAdmin()){toast('沒有管理員權限');return}document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+id));document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===id));if(id==='admin')loadAdminDashboard();if(id==='leaderboard')refreshLeaderboards();window.scrollTo({top:0,behavior:'smooth'})}
document.addEventListener('click',e=>{let b=e.target.closest('[data-page],[data-go]');if(!b)return;go(b.dataset.page||b.dataset.go)});
function itemHTML(d,owned=true){let count=S.bag[d.id]||0;return `<article class="item ${d.den>=65536?'ultra':d.den>=2048?'rare':''}" style="--c:${d.color}"><div class="count">${owned?'×'+count:'???'}</div><div class="ico" style="color:${owned?d.color:'#525873'}">${owned?d.icon:'?'}</div><h3>${owned?d.name:'未知骰子'}</h3><p>${owned?chanceText(d):'尚未發現'}</p><p>${owned?d.desc:'繼續擲骰以解鎖資料。'}</p>${owned&&S.first[d.id]?`<p>首次：${new Date(S.first[d.id]).toLocaleDateString()}</p>`:''}</article>`}

function renderInventory(){const grid=document.getElementById('inventoryGrid');const active=document.activeElement;const typing=active&&active.matches('input[data-sell-qty]')&&grid.contains(active);if(typing){document.getElementById('bagCount').textContent=format(totalDice())+' 顆持有骰子';return}let arr=D.filter(d=>(Number(S.bag[d.id])||0)>0).sort((a,b)=>a.den-b.den);grid.innerHTML=arr.map(d=>{let count=Number(S.bag[d.id])||0;return `<div class="inventory-row" style="--rarity-color:${d.color}"><span class="inventory-chance">${chanceText(d)}</span><span class="inventory-dice">${d.icon} ${d.name}</span><b class="inventory-count">×${format(count)}</b><div class="inventory-sell"><input type="number" min="1" max="${count}" value="1" aria-label="出售${d.name}數量" data-sell-qty="${d.id}"><button class="danger" data-sell="${d.id}">出售數量</button><small class="muted">單顆 ${format(d.den)}€</small></div></div>`}).join('')||'<div class="empty">背包目前沒有骰子。關閉自動出售或開始擲骰來收集骰子。</div>';document.getElementById('bagCount').textContent=format(totalDice())+' 顆持有骰子'}
document.getElementById('inventoryGrid').addEventListener('focusout',e=>{if(e.target.matches('input[data-sell-qty]'))setTimeout(()=>renderInventory(),0)});
function renderCodex(){let n=totalUnique(),pct=Math.round(n/D.length*100);document.getElementById('codexPct').textContent=pct+'% · 已發現 '+n+'/'+D.length;document.getElementById('codexBar').style.width=pct+'%';document.getElementById('codexGrid').innerHTML=[...D].sort((a,b)=>a.den-b.den).map(d=>{let discovered=!!S.first[d.id]||!!S.bag[d.id];let rolls=Number(S.rollCounts?.[d.id])||0;return `<div class="codex-row ${discovered?'':'missing'}" style="--rarity-color:${d.color}"><div class="codex-chance">${discovered?chanceText(d):'???'}</div><div class="codex-name"><span class="codex-icon">${discovered?d.icon:'???'}</span>${discovered?d.name:''}</div><div class="codex-count">${discovered?(rolls?`抽到 ${format(rolls)} 次`:'已獲得'):'???'}</div></div>`}).join('')}
function canCraft(g){return g.recipe.every(([id,n])=>(S.bag[id]||0)>=n)}
function renderGloves(){let g=currentGlove();document.getElementById('gloveLabel').textContent=g.name;document.getElementById('equippedName').textContent=g.icon+' '+g.name;document.getElementById('equippedDesc').textContent=g.desc;document.getElementById('gloveLuck').textContent='+'+g.luck+'%';document.getElementById('gloveSpeed').textContent='+'+g.speed+'%';document.getElementById('gloveOwned').textContent=Object.keys(S.gloves||{}).filter(id=>S.gloves[id]>0).length;
 document.getElementById('recipeList').innerHTML=G.filter(x=>x.id!=='g0').map(x=>{let owned=!!S.gloves[x.id],equipped=S.equipped===x.id;return `<div class="recipe"><div style="flex:1;min-width:0"><h3>${x.icon} ${x.name}${equipped?'（已裝備）':owned?'（已持有）':''}</h3>${x.recipe.map(([id,n])=>{let have=S.bag[id]||0,ok=have>=n;return `<p style="color:${ok?'#65e6b2':'#ff829d'}">${ok?'✓':'缺少'} ${byId(id).name.replace(/骰子/g,'')}（${chanceText(byId(id))}）×${n}：持有 ${format(have)}</p>`}).join('')}<p>運氣 +${x.luck}% · 速度 +${x.speed}%</p></div><button ${owned?(equipped?'disabled':''):(canCraft(x)?'':'disabled')} data-craft="${x.id}">${equipped?'已裝備':owned?'裝備':'合成'}</button></div>`}).join('');
}
function craft(id){let g=glove(id);if(S.gloves[id]){S.equipped=id;save();render();toast('已裝備'+g.name+'（同時只能裝備一副手套）');return}if(!canCraft(g)){toast('材料不足');return}g.recipe.forEach(([did,n])=>{S.bag[did]-=n;if(S.bag[did]<=0)delete S.bag[did]});S.gloves[id]=1;S.equipped=id;S.quest.craft++;checkAchievements();save();if(currentUser)logCraft('glove',id,g.name);render();toast('合成成功並裝備：'+g.name)}
document.addEventListener('click',e=>{let c=e.target.closest('[data-craft]'),eq=e.target.closest('[data-equip]');if(c)craft(c.dataset.craft);if(eq){S.equipped=eq.dataset.equip;save();render();toast('已裝備'+glove(S.equipped).name)}});
function potionMaterialTotal(){return Object.values(S.potions?.materials||{}).reduce((sum,n)=>sum+Math.max(0,Number(n)||0),0)}
function renderPotionAutoAddChoices(){S.potions=S.potions||fresh().potions;S.potions.materials=S.potions.materials||{};{let left=4;for(const id of Object.keys(S.potions.materials)){const n=Math.max(0,Number(S.potions.materials[id])||0),keep=Math.min(n,left);if(keep)S.potions.materials[id]=keep;else delete S.potions.materials[id];left-=keep;}}S.potions.autoAddDice=Array.isArray(S.potions.autoAddDice)?S.potions.autoAddDice.slice(0,2):[];const ids=[...new Set(POTIONS.flatMap(p=>p.recipe.map(([id])=>id)))];document.getElementById('potionAutoAddChoices').innerHTML=ids.map(id=>{const d=byId(id),checked=S.potions.autoAddDice.includes(id);return `<label class="recipe" style="display:flex;align-items:center;gap:8px;padding:8px;cursor:pointer"><input type="checkbox" data-auto-add-dice="${id}" ${checked?'checked':''} ${!checked&&S.potions.autoAddDice.length>=2?'disabled':''}><span style="color:${d.color};font-size:20px">${d.icon}</span><span>${d.name}</span></label>`}).join('');document.getElementById('potionMaterialCount').textContent=S.potions.autoAddDice.length+' / 2 種';document.getElementById('potionMaterialTotal').textContent=potionMaterialTotal()+' / 4 顆'}
function renderPotions(){
 renderPotionAutoAddChoices();
 const a=activePotion();document.getElementById('potionLuckNow').textContent='+'+luck()+'%';document.getElementById('angelCount').textContent=String(Number(S.potions?.angelCharges)||0);
 const left=a?Math.max(0,Number(S.potions.active.expiresAt)-Date.now()):0;document.getElementById('potionTimer').textContent=a?Math.ceil(left/1000)+' 秒':'未啟用';
 document.getElementById('potionStatus').textContent=a?`${a.name} 生效中：運氣 +${a.luck}%`:(S.potions.angelCharges>0?'天堂藥水已準備好，大幅提升下一抽的運氣。':'目前沒有生效中的藥水。');
 document.getElementById('potionList').innerHTML=POTIONS.map(p=>{const count=Number(S.potions.inventory[p.id])||0;const active=a?.id===p.id;const mats=p.recipe.map(([did,n])=>{const d=byId(did),bagHave=Number(S.bag[did])||0,stashHave=Number(S.potions.materials?.[did])||0,have=bagHave+stashHave,ok=have>=n,icons=Array.from({length:Math.min(n,8)},()=>`<span class="slot-icon" style="color:${d.color}">${d.icon}</span>`).join('');return `<div class="potion-recipe-slot" style="border-color:${ok?'#397e6c':'#633747'}"><div class="potion-dice-icons">${icons}</div><div class="slot-name">${d.name}</div><div class="slot-odds">${chanceText(d)}</div><div class="slot-qty">需要 ×${n}</div><div class="potion-material-status" style="color:${ok?'#65e6b2':'#ff829d'}">${ok?'✓ 材料足夠':'缺少材料'}<br><span style="opacity:.8">背包 ${format(bagHave)} · 保留 ${format(stashHave)}</span></div></div>`}).join('<div class="potion-recipe-arrow">＋</div>');const can=Number(S.coins)>=p.cost&&p.recipe.every(([did,n])=>(Number(S.bag[did])||0)+(Number(S.potions.materials?.[did])||0)>=n);return `<article class="potion-card"><div class="potion-card-head"><div class="potion-card-icon">${p.icon}</div><div class="potion-card-title"><h3>${p.name}</h3><p>${p.desc}</p></div><span class="potion-owned">持有 ${count}${active?' · 生效中':''}</span></div><div><div class="potion-section-label">合成材料</div><div class="potion-recipe-flow"><div class="potion-materials">${mats}</div><div class="potion-recipe-arrow">➜</div><div class="potion-recipe-slot potion-result-slot"><div class="slot-icon">${p.icon}</div><div class="slot-name">${p.name}</div><div class="slot-qty">合成結果</div></div></div></div><div class="potion-cost"><span>合成費用</span><strong>${format(p.cost)}€</strong></div><div class="potion-action-buttons"><button class="potion-auto-add ${S.potions.autoAdd?'active':''}" data-toggle-auto-add>${S.potions.autoAdd?'自動添加：開':'自動添加：關'}</button><button data-craft-potion="${p.id}" ${can?'':'disabled'}>合成藥水</button><button class="primary" data-use-potion="${p.id}" ${count<1?'disabled':''}>使用藥水</button></div></article>`}).join('');
}
function craftPotion(id){const p=POTIONS.find(x=>x.id===id);if(!p)return;S.potions=S.potions||fresh().potions;S.potions.materials=S.potions.materials||{};if(Number(S.coins)<p.cost){toast('€ 不足');return}for(const [did,n] of p.recipe){if((Number(S.bag[did])||0)+(Number(S.potions.materials[did])||0)<n){toast('骰子材料不足');return}}S.coins-=p.cost;for(const [did,n] of p.recipe){let need=n,stash=Number(S.potions.materials[did])||0,take=Math.min(stash,need);if(take){S.potions.materials[did]=stash-take;need-=take}if(!S.potions.materials[did])delete S.potions.materials[did];if(need){S.bag[did]=(Number(S.bag[did])||0)-need;if(S.bag[did]<=0)delete S.bag[did]}}S.potions.inventory[id]=(Number(S.potions.inventory[id])||0)+1;if(currentUser)logCraft('potion',id,p.name);S.quest=S.quest||{rolls:0,rare:0,craft:0};S.quest.craft=(Number(S.quest.craft)||0)+1;checkAchievements();save();render();toast('合成成功：'+p.name)}
function usePotion(id){const p=POTIONS.find(x=>x.id===id);if(!p)return;S.potions=S.potions||fresh().potions;S.potions.inventory=S.potions.inventory||{};const count=Number(S.potions.inventory[id])||0;if(count<1){toast('沒有這瓶藥水');return}if(id==='angel1'){S.potions.inventory[id]=count-1;S.potions.angelCharges=(Number(S.potions.angelCharges)||0)+1;save();render();toast('天堂藥水已準備好：大幅提升下一抽的運氣');return}const current=activePotion();let nextExpiry=Date.now()+p.duration;if(current&&S.potions.active?.type===id){nextExpiry=Math.max(Date.now(),Number(S.potions.active.expiresAt)||0)+p.duration}else if(current&&S.potions.active?.type!==id){const promptText=p.luck>current.luck?`要取代目前的${current.name}嗎？使用${p.name}後，原本的剩餘時間將被取代。`:`目前的${current.name}還在生效。要改用${p.name}並取代目前效果嗎？`;if(!confirm(promptText))return}S.potions.inventory[id]=count-1;S.potions.active={type:id,expiresAt:nextExpiry};save();render();toast(current&&current.id===id?`${p.name}時間已延長，剩餘 ${Math.ceil((nextExpiry-Date.now())/1000)} 秒`:`${p.name}已生效 5 分鐘`)}
document.addEventListener('change',e=>{const box=e.target.closest('[data-auto-add-dice]');if(!box)return;S.potions=S.potions||fresh().potions;S.potions.autoAddDice=Array.isArray(S.potions.autoAddDice)?S.potions.autoAddDice:[];const id=box.dataset.autoAddDice;if(box.checked){if(S.potions.autoAddDice.length>=2){box.checked=false;toast('自動添加最多只能選擇 2 種骰子');return}if(!S.potions.autoAddDice.includes(id))S.potions.autoAddDice.push(id)}else S.potions.autoAddDice=S.potions.autoAddDice.filter(x=>x!==id);save();renderPotions()});
document.addEventListener('click',e=>{const t=e.target.closest('[data-toggle-auto-add]'),c=e.target.closest('[data-craft-potion]'),u=e.target.closest('[data-use-potion]');if(t){S.potions=S.potions||fresh().potions;S.potions.autoAdd=!S.potions.autoAdd;save();renderPotions();toast(S.potions.autoAdd?'已開啟自動添加：抽到的藥水材料會另外收集':'已關閉自動添加');}if(c)craftPotion(c.dataset.craftPotion);if(u)usePotion(u.dataset.usePotion)});
function grantAchievementReward(reward){if(!reward)return;if(reward.type==='coins')S.coins=(Number(S.coins)||0)+reward.amount;else if(reward.type==='potion'){S.potions=S.potions||fresh().potions;S.potions.inventory=S.potions.inventory||{};S.potions.inventory[reward.id]=(Number(S.potions.inventory[reward.id])||0)+reward.amount}}
function rewardText(reward){return reward.type==='coins'?format(reward.amount)+'€':POTIONS.find(p=>p.id===reward.id)?.name+' ×'+reward.amount}
function checkAchievements(){S.achievements=S.achievements||{};const checks=[
 ['roll100','擲骰新手',S.rolls>=100,'累積擲骰 100 次',{type:'coins',amount:100}],
 ['roll1000','命運常客',S.rolls>=1000,'累積擲骰 1,000 次',{type:'coins',amount:1000}],
 ['roll10000','擲骰熟手',S.rolls>=10000,'累積擲骰 10,000 次',{type:'potion',id:'luck2',amount:2}],
 ['roll100000','命運征服者',S.rolls>=100000,'累積擲骰 100,000 次',{type:'potion',id:'angel1',amount:1}],
 ['collect5','收藏起步',totalUnique()>=5,'發現 5 種骰子',{type:'coins',amount:500}],
 ['collect12','收藏家',totalUnique()>=12,'發現 12 種骰子',{type:'coins',amount:1200}],
 ['collect20','收藏大師',totalUnique()>=20,'發現 20 種骰子',{type:'potion',id:'luck3',amount:1}],
 ['rare2048','稀有發現者',!!S.best&&S.best.den>=2048,'獲得 1/2048 或更稀有的骰子',{type:'potion',id:'luck2',amount:1}],
 ['rare1m','百萬分之一',!!S.best&&S.best.den>=1000000,'獲得 1/1,000,000 或更稀有的骰子',{type:'potion',id:'luck3',amount:1}]
 ];let changed=false;checks.forEach(([id,name,ok,desc,reward])=>{if(!ok)return;let a=S.achievements[id];if(!a){a={name,desc,reward:rewardText(reward),rewardGiven:false,unlockedAt:new Date().toISOString()};S.achievements[id]=a;changed=true}if(!a.rewardGiven){grantAchievementReward(reward);a.rewardGiven=true;a.reward=rewardText(reward);changed=true;toast('成就完成：'+name+'，獲得 '+rewardText(reward))}});return changed}
function ensureDailyQuest(){const today=new Date().toLocaleDateString('en-CA');if(S.questDate!==today){S.questDate=today;S.quest={rolls:0,rare:0,craft:0,coinsEarned:0,rewardClaimed:false};save()}S.quest=S.quest||{rolls:0,rare:0,craft:0,rewardClaimed:false};if(typeof S.quest.rewardClaimed!=='boolean')S.quest.rewardClaimed=false;}
function checkDailyReward(){ensureDailyQuest();if(S.quest.rewardClaimed)return false;const done=(Number(S.quest.rolls)||0)>=25&&(Number(S.quest.rare)||0)>=1&&(Number(S.quest.coinsEarned)||0)>=5000;if(!done)return false;S.quest.rewardClaimed=true;S.coins=(Number(S.coins)||0)+888;toast('每日任務全部完成！獲得 888€');save();return true}
function renderQuests(){ensureDailyQuest();checkDailyReward();const tasks=[['rolls','擲骰 25 次',Math.min(Number(S.quest.rolls)||0,25),25],['rare','獲得 1/2048 或更稀有骰子 1 次',Math.min(Number(S.quest.rare)||0,1),1],['craft','合成手套 1 次',Math.min(Number(S.quest.craft)||0,1),1]];const coinProgress=Math.min(Number(S.quest.coinsEarned)||0,5000);tasks[2]=['coinsEarned','獲得 5,000€',coinProgress,5000];const allDone=tasks.every(([id,n,v,m])=>v>=m);document.getElementById('questList').innerHTML=tasks.map(([id,n,v,m])=>`<div class="recipe"><div style="flex:1"><h3>${n}</h3><p>${v}/${m}</p><div class="bar"><span style="width:${v/m*100}%"></span></div></div><span>${v>=m?'✓':'…'}</span></div>`).join('')+`<div class="recipe"><div><h3>每日完成獎勵</h3><p>${allDone?'今日任務已全部完成':'完成全部 3 項每日任務即可領取'}</p></div><b>${S.quest.rewardClaimed?'已領取':'+888€'}</b></div>`;const achievementRows=[['roll100','擲骰新手',`累積擲骰 ${format(Math.min(S.rolls,100))}/100 次`,'100€'],['roll1000','命運常客',`累積擲骰 ${format(Math.min(S.rolls,1000))}/1,000 次`,'1,000€'],['roll10000','擲骰熟手',`累積擲骰 ${format(Math.min(S.rolls,10000))}/10,000 次`,'運氣藥水 II ×2'],['roll100000','命運征服者',`累積擲骰 ${format(Math.min(S.rolls,100000))}/100,000 次`,'天堂藥水 I ×1'],['collect5','收藏起步',`發現 ${Math.min(totalUnique(),5)}/5 種骰子`,'500€'],['collect12','收藏家',`發現 ${Math.min(totalUnique(),12)}/12 種骰子`,'1,200€'],['collect20','收藏大師',`發現 ${Math.min(totalUnique(),20)}/20 種骰子`,'運氣藥水 III ×1'],['rare2048','稀有發現者',`最高紀錄：${S.best?'1/'+format(S.best.den):'尚未獲得'}（目標 1/2,048 或更稀有）`,'運氣藥水 II ×1'],['rare1m','百萬分之一',`最高紀錄：${S.best?'1/'+format(S.best.den):'尚未獲得'}（目標 1/1,000,000 或更稀有）`,'運氣藥水 III ×1']];document.getElementById('achievementList').innerHTML=achievementRows.map(([id,name,desc,reward])=>{const unlocked=!!S.achievements[id];return `<div class="recipe"><div><h3>${unlocked?'✦':'◇'} ${name}</h3><p>${desc}</p><p class="mini">獎勵：${reward}</p></div><span>${unlocked?'已完成':'未完成'}</span></div>`}).join('')}
function renderProfile(){document.getElementById('profileName').textContent=S.name;document.getElementById('profileNameInput').value=S.name;document.getElementById('joined').textContent='加入時間：'+new Date(S.joined).toLocaleDateString();document.getElementById('profileRolls').textContent=format(S.rolls);document.getElementById('profileUnique').textContent=totalUnique()+' / '+D.length;document.getElementById('profileGloves').textContent=Object.keys(S.gloves||{}).filter(id=>S.gloves[id]>0).length;document.getElementById('bestRecord').innerHTML=S.best?`<b>${byId(S.best.id).name}</b> <span class="rarity">${chanceText(byId(S.best.id))}</span><p class="muted">發現時間：${new Date(S.best.time).toLocaleString()}</p>`:'尚無紀錄'}
async function adminApi(payload){if(!isAdmin())throw new Error('沒有管理員權限');const {data:{session}}=await supabaseClient.auth.getSession();if(!session?.access_token)throw new Error('登入狀態已失效，請重新登入');const res=await fetch(SUPABASE_URL+'/functions/v1/dice-rng-admin',{method:'POST',headers:{'Content-Type':'application/json','apikey':SUPABASE_KEY,'Authorization':'Bearer '+session.access_token},body:JSON.stringify(payload)});const data=await res.json().catch(()=>({error:'伺服器回應格式錯誤'}));if(!res.ok)throw new Error(data.error||'管理操作失敗');return data}
async function loadAdminDashboard(){if(!isAdmin())return;const players=document.getElementById('adminPlayers'),logs=document.getElementById('adminCraftLogs');players.innerHTML='<div class="empty">正在載入玩家狀況…</div>';logs.innerHTML='<div class="empty">正在載入合成紀錄…</div>';try{const data=await adminApi({action:'dashboard'});document.getElementById('adminPlayerCount').textContent=format(data.players.length);document.getElementById('adminOnlineCount').textContent=format(data.onlineCount);players.innerHTML=data.players.map(p=>`<div class="admin-player"><div style="min-width:0"><b>${escapeHTML(p.username||'玩家')}</b><div class="mini">擲骰 ${format(p.total_rolls||0)} 次 · 骰子 ${format(p.unique_dice||0)} 種 · ${format(p.coins||0)}€</div><div class="mini">最後活動：${p.last_seen?new Date(p.last_seen).toLocaleString():'尚無紀錄'}</div></div><span class="pill ${p.online?'admin-online':'admin-offline'}">${p.online?'● 在線':'○ 離線'}</span></div>`).join('')||'<div class="empty">尚無玩家資料</div>';logs.innerHTML=data.crafts.map(x=>`<div class="admin-log"><div><b>${escapeHTML(x.username||'玩家')} · ${escapeHTML(x.item_name||x.item_id)}</b><div class="mini">${x.item_type==='potion'?'藥水合成':'手套合成'} · ${new Date(x.created_at).toLocaleString()}</div></div><span class="pill">#${x.id}</span></div>`).join('')||'<div class="empty">目前沒有合成紀錄</div>'}catch(e){players.innerHTML=logs.innerHTML=`<div class="empty">${escapeHTML(e.message||'載入失敗')}</div>`}}
async function logCraft(type,id,name){if(!currentUser||!supabaseClient)return;try{const {error}=await supabaseClient.from('craft_logs').insert({user_id:currentUser.id,username:(S.name||'玩家').slice(0,20),item_type:type,item_id:id,item_name:name});if(error)throw error}catch(e){console.warn('Craft log failed',e)}}
function sellMany(id,button){const d=byId(id);if(!d)return;const row=button?.closest('.inventory-row');const input=row?.querySelector(`[data-sell-qty="${id}"]`);const have=Number(S.bag[id])||0;const amount=Math.floor(Number(input?.value)||0);if(have<=0||amount<1){toast('請輸入有效出售數量');return}if(amount>have){toast('出售數量不能超過持有數量');if(input)input.value=String(have);return}S.bag[id]=have-amount;if(S.bag[id]<=0)delete S.bag[id];const earned=d.den*amount;S.coins=(Number(S.coins)||0)+earned;S.quest=S.quest||{};S.quest.coinsEarned=(Number(S.quest.coinsEarned)||0)+earned;checkDailyReward();save();render();toast(`已出售${d.name} ×${format(amount)} +${format(earned)}€`)}
document.addEventListener('click',e=>{const b=e.target.closest('[data-sell]');if(b)sellMany(b.dataset.sell,b)});
function render(){if(checkAchievements())save();document.getElementById('playerName').textContent=S.name;document.getElementById('avatar').textContent=(S.name||'旅').slice(0,1);document.getElementById('totalRolls').textContent=format(S.rolls);document.getElementById('uniqueCount').textContent=totalUnique()+' / '+D.length;document.getElementById('luckStat').textContent='+'+luck()+'%';document.getElementById('coinBalance').textContent=format(Number(S.coins)||0)+'€';document.getElementById('bagTotal').textContent=totalDice()+' / '+(Number(S.bagCapacity)||35);document.getElementById('bagCapacity').textContent=totalDice()+' / '+(Number(S.bagCapacity)||35)+' 顆';document.getElementById('autoSoldCount').textContent=format(Number(S.autoSold)||0);document.getElementById('autoSellThreshold').value=String(Number(S.autoSellThreshold)||0);document.getElementById('rollBtn').disabled=rolling||totalDice()>=(Number(S.bagCapacity)||35);document.getElementById('autoBtn').disabled=totalDice()>=(Number(S.bagCapacity)||35)||!!autoTimer;const cap=Number(S.bagCapacity)||35,up=document.getElementById('upgradeBagBtn');up.disabled=cap>=100||Number(S.coins)<bagUpgradeCost(cap);up.textContent=cap>=100?'已達上限':'擴充 +1 · '+format(bagUpgradeCost(cap))+'€';document.getElementById('bagUpgradeInfo').textContent=cap>=100?'容量 '+cap+'/100，已達上限':`容量 ${cap}/100 · 下次擴充 ${format(bagUpgradeCost(cap))}€`;renderInventory();renderCodex();renderGloves();renderPotions();renderQuests();renderProfile();}
function bagUpgradeCost(currentCapacity){const next=currentCapacity+1;return next<=39?1000:1000+(next-39)*250}
document.getElementById('upgradeBagBtn').onclick=()=>{const cap=Number(S.bagCapacity)||35;if(cap>=100){toast('背包已達目前上限 100 顆');return}const cost=bagUpgradeCost(cap);if((Number(S.coins)||0)<cost){toast(`€ 不足，擴充需要 ${format(cost)}€`);return}S.coins-=cost;S.bagCapacity=cap+1;save();render();toast(`背包容量已擴充至 ${S.bagCapacity} 顆`)};
document.getElementById('rollBtn').onclick=doRoll;
document.getElementById('authOpenBtn').onclick=openAuth;document.getElementById('authCloseBtn').onclick=closeAuth;document.getElementById('authLoginBtn').onclick=()=>authAction('login');document.getElementById('authSignupBtn').onclick=()=>authAction('signup');document.getElementById('authResetBtn').onclick=()=>authAction('reset');document.getElementById('authLogoutBtn').onclick=async()=>{await supabaseClient?.auth.signOut();toast('已登出雲端帳號')};document.getElementById('page-leaderboard').addEventListener('click',refreshLeaderboards);document.getElementById('refreshLeaderboardBtn').onclick=refreshLeaderboards;
document.getElementById('adminRefreshBtn').onclick=loadAdminDashboard;document.getElementById('adminGrantType').addEventListener('change',e=>{document.getElementById('adminPotionSelectWrap').hidden=e.target.value!=='potion'});document.getElementById('adminGrantBtn').onclick=async()=>{if(!isAdmin()){toast('沒有管理員權限');return}const type=document.getElementById('adminGrantType').value,amount=Math.floor(Number(document.getElementById('adminGrantAmount').value)||0),potionId=document.getElementById('adminPotionId').value;if(amount<1||amount>1000000000){toast('請輸入 1 到 1,000,000,000 的有效數量');return}const label=type==='coins'?`${format(amount)}€`:`${document.getElementById('adminPotionId').selectedOptions[0].text} ×${format(amount)}`;if(!confirm(`確定發放 ${label} 給全體玩家？此操作無法自動撤回。`))return;const btn=document.getElementById('adminGrantBtn'),msg=document.getElementById('adminMessage');btn.disabled=true;msg.textContent='正在透過雲端發放…';try{const result=await adminApi({action:'grant',type,amount,potionId});msg.textContent=`發放完成：${result.affected} 位玩家，每位獲得 ${label}。`;toast('全體玩家發放完成');await loadAdminDashboard()}catch(e){msg.textContent=e.message||'發放失敗';toast(msg.textContent)}finally{btn.disabled=false}};updateAdminVisibility();
function stopAuto(){if(autoTimer)clearInterval(autoTimer);autoTimer=null;document.getElementById('autoBtn').classList.remove('roll-progress');document.getElementById('autoBtn').disabled=false;document.getElementById('stopBtn').disabled=true}
document.getElementById('autoBtn').onclick=()=>{if(autoTimer||totalDice()>=(Number(S.bagCapacity)||35)){if(totalDice()>=(Number(S.bagCapacity)||35))go('inventory');return}document.getElementById('autoBtn').disabled=true;document.getElementById('stopBtn').disabled=false;autoTimer=setInterval(()=>{if(totalDice()>=(Number(S.bagCapacity)||35)){stopAuto();go('inventory');toast('背包已滿，自動擲骰停止');return}if(!rolling)doRoll()},Math.max(650,1300/(1+speed()/100)));toast('自動擲骰已開始')};
document.getElementById('stopBtn').onclick=stopAuto;
// 自動擲骰期間切換頁面或點擊出售數量欄位，不主動停止自動擲骰。
document.getElementById('autoSellThreshold').addEventListener('change',e=>{S.autoSellThreshold=Number(e.target.value)||0;save();render();toast(S.autoSellThreshold?'自動出售設定已保存':'已關閉自動出售')});
document.getElementById('nameBtn').onclick=()=>{let n=prompt('輸入你的玩家名稱',S.name);if(n&&n.trim()){S.name=n.trim().slice(0,20);save();render()}};
document.getElementById('saveName').onclick=()=>{let n=document.getElementById('profileNameInput').value.trim();if(!n){toast('名稱不可空白');return}S.name=n.slice(0,20);save();render();toast('名稱已保存')};
document.getElementById('resetBtn').onclick=()=>{if(confirm('確定重設這台裝置上的所有試玩資料？此操作無法復原。')){stopAuto();S=fresh();save();render();toast('試玩資料已重設')}};
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>go(b.dataset.go)));
save();render();refreshLeaderboards();setInterval(()=>{if(activePotion())renderPotions();else if(S.potions?.active?.type&&S.potions.active.expiresAt<=Date.now()){S.potions.active={type:'',expiresAt:0};save();render()}},1000);
</script></body></html>
